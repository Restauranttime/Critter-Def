{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && $code.length === 4",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
            ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 20"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "board": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
        ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 20"
      }
    },
    "daily": {
      "$day": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && (!data.exists() || data.child('done').val() === false)",
          ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('r').isNumber() && newData.child('r').val() >= 0 && newData.child('r').val() <= 10 && newData.child('ms').isNumber() && newData.child('done').isBoolean()"
        }
      }
    }
  }
}
